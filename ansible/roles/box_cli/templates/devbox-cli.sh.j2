#!/usr/bin/env bash
# Managed by Ansible (remote-devbox) — do not edit by hand.
#
# The box-side `devbox` command. Its whole job is to make the container engine an
# implementation detail: you type the same thing in every project, and the engine that
# project resolved to is what runs. The mapping is looked up, never re-derived — it was
# already decided when devbox.yml was normalized.
#
#   devbox engine                 which engine applies here, and why
#   devbox container status       containers, images and disk for this developer
#   devbox container doctor       is the rootless engine actually healthy?
#   devbox compose up|down|...    engine-agnostic compose
#   devbox doctor                 is this box still the box the config describes?
#   devbox client-config          what your laptop needs to reach this box
set -euo pipefail

ENGINES=/etc/remote-devbox/engines.json
ME="$(id -un)"

die() { echo "devbox: $*" >&2; exit 1; }

# The project is whichever ~/projects/<name> the working directory sits under; outside
# one, the developer's default engine applies.
current_project() {
  local root="$HOME/projects" here
  here="$(pwd -P)"
  case "$here" in
    "$root"/*) echo "${here#"$root"/}" | cut -d/ -f1 ;;
    *) echo "" ;;
  esac
}

resolve_engine() {
  local project="$1"
  [[ -r "$ENGINES" ]] || die "no engine map at $ENGINES — re-run the playbook"
  python3 - "$ENGINES" "$ME" "$project" <<'PY'
import json, sys
path, user, project = sys.argv[1], sys.argv[2], sys.argv[3]
data = json.load(open(path)).get(user)
if data is None:
    sys.exit(f"devbox: {user} is not an account on this box")
print(data["projects"].get(project) or data["default"])
PY
}

# A rootless daemon listens on the developer's own socket, not /var/run/docker.sock.
# Exporting it here means the CLI works from a non-interactive ssh command too, where
# no rc file has been sourced.
export_docker_host() {
  [[ -n "${DOCKER_HOST:-}" ]] && return 0
  export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock"
}

engine_cmd() {
  case "$1" in
    podman-rootless) echo podman ;;
    docker-rootless) echo docker ;;
    none) die "containers are disabled for this project (container_engine: none)" ;;
    *) die "unknown engine '$1'" ;;
  esac
}

cmd_engine() {
  local project engine
  project="$(current_project)"
  engine="$(resolve_engine "$project")"
  if [[ -n "$project" ]]; then
    echo "$engine   (project '$project')"
  else
    echo "$engine   (developer default — not inside a project)"
  fi
}

cmd_container() {
  local action="${1:-status}" engine bin
  engine="$(resolve_engine "$(current_project)")"
  bin="$(engine_cmd "$engine")"
  [[ "$engine" == docker-rootless ]] && export_docker_host
  case "$action" in
    status)
      echo "engine: $engine"
      "$bin" ps --all
      echo
      "$bin" images
      echo
      "$bin" system df
      ;;
    doctor)
      echo "engine:   $engine"
      echo "binary:   $(command -v "$bin" || echo MISSING)"
      command -v "$bin" >/dev/null || die "$bin is not installed — add it to container.install_engines"
      # Rootless is the property worth asserting: a rootful engine on a shared box
      # means one developer can read every other developer's files.
      if [[ "$bin" == podman ]]; then
        echo "rootless: $("$bin" info --format '{{"{{"}}.Host.Security.Rootless{{"}}"}}')"
        echo "socket:   ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
      else
        echo "host:     ${DOCKER_HOST:-<unset — rootless socket not exported>}"
        "$bin" info --format 'rootless: {{"{{"}}.SecurityOptions{{"}}"}}' || true
      fi
      "$bin" info >/dev/null && echo "health:   ok"
      ;;
    cleanup)
      # Destructive, so it is never part of `status` and never part of an apply.
      echo "This removes stopped containers, unused images and dangling volumes for $ME ($engine)."
      read -r -p "Type 'yes' to continue: " confirm
      [[ "$confirm" == yes ]] || die "aborted"
      "$bin" system prune --all --volumes
      ;;
    *) die "unknown action '$action' (status|doctor|cleanup)" ;;
  esac
}

# ── doctor ────────────────────────────────────────────────────────────────────
# Checks the properties that are supposed to be TRUE, not the ones that are easy to
# print. Each one has been an actual failure mode: a home that reverted to 0755, a
# developer quietly added to the docker group, a bank shared between two people.
PASS=0; FAIL=0; WARN=0
ok()   { printf '  \033[32m✔\033[0m %s\n' "$1"; PASS=$((PASS+1)); }
bad()  { printf '  \033[31m✘\033[0m %s\n' "$1"; FAIL=$((FAIL+1)); }
meh()  { printf '  \033[33m!\033[0m %s\n' "$1"; WARN=$((WARN+1)); }
check() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else bad "$1"; fi; }

cmd_doctor() {
  local uid; uid="$(id -u)"

  echo "platform"
  . /etc/os-release
  check "$PRETTY_NAME $(uname -m)" "true"
  check "root filesystem has >10G free" "[ \"$(df -BG --output=avail / | tail -1 | tr -dc 0-9)\" -gt 10 ]"

  echo "isolation"
  local home_mode; home_mode="$(stat -c %a "$HOME")"
  if [ "$home_mode" = 700 ]; then ok "my home is private (0700)"; else bad "my home is $home_mode, not 0700"; fi
  if [ "$(umask)" = 0077 ]; then ok "umask is private"; else bad "umask is $(umask), not 0077"; fi
  check "I have no sudo" "! sudo -n true"
  # A rootful docker group is root-equivalent: it can bind-mount any home as root.
  if id -nG | tr ' ' '\n' | grep -qx docker; then bad "I am in the docker group (root-equivalent)"; else ok "I am not in the docker group"; fi
  check "other users' processes are hidden" "grep -qE '(^|,)hidepid=(2|invisible)([,[:space:]]|$)' /proc/mounts"
  local other
  for other in $(awk -F: '$3>=1000 && $3<65534 {print $1}' /etc/passwd); do
    [ "$other" = "$ME" ] && continue
    [ -d "/home/$other" ] || continue
    if ls "/home/$other" >/dev/null 2>&1; then bad "I can read /home/$other"; else ok "/home/$other is closed to me"; fi
  done

  echo "resources"
  local slice="/sys/fs/cgroup/user.slice/user-$uid.slice"
  if [ -r "$slice/memory.max" ]; then
    ok "slice memory.max=$(cat "$slice/memory.max") memory.high=$(cat "$slice/memory.high" 2>/dev/null || echo -)"
  else
    meh "no cgroup limits on my user slice"
  fi
  check "cgroup controllers are delegated" "grep -qw memory \"$slice/cgroup.controllers\""

  echo "containers"
  local engine; engine="$(resolve_engine "$(current_project)")"
  if [ "$engine" = none ]; then
    ok "containers disabled here"
  else
    local bin; bin="$(engine_cmd "$engine")"
    [ "$engine" = docker-rootless ] && export_docker_host
    check "$engine responds" "$bin info"
    if [ "$bin" = podman ]; then
      if [ "$(podman info --format '{{"{{"}}.Host.Security.Rootless{{"}}"}}')" = true ]; then
        ok "podman is rootless"
      else
        bad "podman is NOT rootless — one developer could read every other developer's files"
      fi
    else
      check "docker is rootless" "docker info --format '{{"{{"}}.SecurityOptions{{"}}"}}' | grep -q rootless"
    fi
  fi

  echo "memory"
  local bank="${HINDSIGHT_BANK_ID:-}" port="${HINDSIGHT_API_PORT:-}"
  if [ -z "$port" ]; then
    meh "no memory wired into this shell (run an agent launcher, or memory is off)"
  else
    check "memory daemon on 127.0.0.1:$port" "ss -Hltn | grep -q \"127.0.0.1:$port\""
    # A bank belonging to another developer is the one memory failure that leaks data.
    if [ -n "$bank" ] && [ "${bank#"$ME"}" = "$bank" ]; then
      meh "bank '$bank' is not namespaced to $ME — confirm it is not another developer's"
    elif [ -n "$bank" ]; then
      ok "bank $bank"
    fi
  fi

  echo "network"
  # Anything bound to a wildcard address is reachable from the internet unless ufw says
  # otherwise. sshd is excluded: its exposure is a deliberate policy setting.
  local public
  public="$(ss -Hltn | awk '{print $4}' | grep -E '^(0[.]0[.]0[.]0|\[::\]):' | grep -vE ':(22|2022)$' || true)"
  if [ -n "$public" ]; then
    meh "listening on every interface: $(echo "$public" | tr '\n' ' ')"
  else
    ok "nothing but sshd is bound to every interface"
  fi

  echo
  printf '%d passed, %d warnings, %d failed\n' "$PASS" "$WARN" "$FAIL"
  [ "$FAIL" -eq 0 ]
}

cmd_compose() {
  local engine bin project
  project="$(current_project)"
  [[ -n "$project" ]] || die "not inside a project under ~/projects"
  engine="$(resolve_engine "$project")"
  bin="$(engine_cmd "$engine")"
  [[ "$engine" == docker-rootless ]] && export_docker_host
  exec "$bin" compose "$@"
}


# ── client-config ─────────────────────────────────────────────────────────────
# What a laptop needs to reach this box, emitted by the box itself. A developer never
# needs the repo, and never has to be told an address: they already have ssh, and this
# describes the box from the box.
CLIENT=/etc/remote-devbox/client.json

client_field() {
  python3 - "$CLIENT" "$1" <<'PY'
import json, sys
print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))
PY
}

# Tailnet-first with a silent fallback. ssh keeps the FIRST value it obtains for a
# keyword, so the Match block wins when the probe says the tailnet is usable and the
# plain Host block supplies the public address otherwise. Everything that speaks ssh
# inherits it: -L tunnels, scp, rsync, sshfs, VS Code Remote-SSH, and this CLI.
# <prefix>-<user>, unless the account name already carries the prefix — an operator
# called devbox-admin should not answer to "devbox-devbox-admin".
alias_for() {
  case "$2" in
    "$1"-*|"$1") echo "$2" ;;
    *) echo "$1-$2" ;;
  esac
}

emit_ssh_config() {
  local user="$1" prefix pub ts al
  prefix="$(client_field prefix)"; pub="$(client_field public_host)"; ts="$(client_field tailnet_host)"
  al="$(alias_for "$prefix" "$user")"
  # The box cannot know where a client keeps its private key, so this is the conventional
  # path. IdentitiesOnly WITHOUT an IdentityFile offers no key at all — that fails as
  # "Permission denied (publickey)" and reads like a server problem.
  local id="    IdentityFile ~/.ssh/id_ed25519\n    IdentitiesOnly yes\n"

  echo "# >>> remote-devbox $al >>>"
  echo "# Change IdentityFile below if your key lives elsewhere."
  if [ -n "$ts" ]; then
    echo "# The tailnet is a route here, not a credential — sshd is key-only on both paths."
    printf 'Match host %s exec "devbox-tailnet-up %s"\n    HostName %s\n' "$al" "$ts" "$ts"
  fi
  printf "Host %s\n    HostName %s\n    User %s\n    Port 22\n${id}" "$al" "$pub" "$user"
  if [ -n "$ts" ]; then
    echo
    echo "# Pinned variants, to force one path when comparing or debugging."
    printf "Host %s-ts\n    HostName %s\n    User %s\n    Port 22\n${id}" "$al" "$ts" "$user"
    printf "Host %s-pub\n    HostName %s\n    User %s\n    Port 22\n${id}" "$al" "$pub" "$user"
  fi
  echo "# <<< remote-devbox $al <<<"
}

emit_client_json() {
  python3 - "$CLIENT" "$1" <<'PY'
import json, sys
box = json.load(open(sys.argv[1]))
user = sys.argv[2]
projects = box["accounts"].get(user)
if projects is None:
    sys.exit(f"devbox: {user} is not a managed developer")

# Carry the file bridge and app configs through under the names the CLI's Profile type
# uses. Without them a client with no repo checkout has no way to know the sync disk is
# even enabled, and every `devbox sync` / `devbox config` command reports the feature as
# off rather than as unconfigured. The operator account has neither, hence the defaults.
bridge = (box.get("file_bridges") or {}).get(user) or {}
apps = (box.get("app_configs") or {}).get(user) or {}

profile = {
    "user": user,
    "projects": [{"name": p["name"], "repo": p.get("repo", "")} for p in projects],
}
if bridge.get("sync_disk"):
    profile["syncDisk"] = True
    # Only meaningful alongside the disk; emitting it on its own suggests a sync that
    # was never configured.
    if bridge.get("engine"):
        profile["syncEngine"] = bridge["engine"]
# Independent of the disk: a developer can serve client paths on demand without syncing
# anything, so these are carried whether or not sync_disk is set.
if bridge.get("lazy_mounts"):
    profile["lazyMounts"] = bridge["lazy_mounts"]
    if bridge.get("lazy_mount_on_connect"):
        profile["lazyMountOnConnect"] = True
# paths are already fully resolved by the generator — nothing to look up client-side.
if apps.get("enabled") and apps.get("paths"):
    profile["appConfigs"] = apps["paths"]

json.dump(
    {
        "prefix": box["prefix"],
        # Reference only: the CLI dials the ssh alias, so the alias decides the path.
        "host": box["tailnet_host"] or box["public_host"],
        "default": user,
        "locale": box["locale"],
        "launch": "",
        "profiles": [profile],
    },
    sys.stdout,
    indent=2,
)
print()
PY
}

CLIENT_BIN=/usr/local/share/remote-devbox/clients

# Prints the path to the CLI binary for a platform, so a client can scp it. The bytes are
# not streamed through here: 60-90MB over a command channel is scp's job, and a path plus
# a published checksum lets the client verify what it got.
emit_cli_path() {
  local plat="$1" bin="$CLIENT_BIN/devbox-$1"
  [ -n "$plat" ] || die "which platform? e.g. darwin-arm64 (see --cli with no argument)"
  if [ ! -f "$bin" ]; then
    local have
    have=$(cd "$CLIENT_BIN" 2>/dev/null && ls devbox-* 2>/dev/null | sed 's/^devbox-//' | tr '\n' ' ')
    die "no CLI published for $plat${have:+ (published: $have)} — the operator sets clients.cli_targets in devbox.yml"
  fi
  echo "$bin"
}

# `--installer` prints a script rather than doing the work over the wire, so what gets
# written to a laptop can be read first. Piping a remote command into a shell is the
# habit this avoids teaching.
emit_installer() {
  local user="$1" prefix pub
  prefix="$(client_field prefix)"; pub="$(client_field public_host)"
  cat <<INSTALLER
#!/bin/sh
# remote-devbox client setup for $user, generated by the box on $(date -u +%Y-%m-%dT%H:%MZ).
#
# Writes four files and nothing else:
#   ~/.local/bin/devbox-tailnet-up          probe: is the tailnet a usable route right now
#   ~/.local/bin/devbox                     the CLI itself, compiled — no repo, no Bun
#   ~/.ssh/config                           a managed block, appended (existing one replaced)
#   ~/.config/remote-devbox/config.json     which box, which account, which projects,
#                                           and how its file bridge is configured
#
# Every file it touches is backed up first. Re-running is safe.
set -eu

BOX=$pub
USER_NAME=$user
ALIAS=$(alias_for "$prefix" "$user")
SSH_CFG="\$HOME/.ssh/config"
STAMP="\$(date +%Y%m%d-%H%M%S)"

say() { printf '  %s\\n' "\$1"; }
ask() { printf '%s ' "\$1"; read -r REPLY; [ "\$REPLY" = y ] || [ "\$REPLY" = Y ]; }

fetch() { ssh -o BatchMode=yes "\$USER_NAME@\$BOX" "devbox client-config \$1"; }

echo "remote-devbox client setup for \$USER_NAME on \$BOX"
echo

# 1. probe
mkdir -p "\$HOME/.local/bin"
fetch --probe > "\$HOME/.local/bin/devbox-tailnet-up"
chmod +x "\$HOME/.local/bin/devbox-tailnet-up"
say "wrote ~/.local/bin/devbox-tailnet-up"

case ":\$PATH:" in
  *":\$HOME/.local/bin:"*) ;;
  *) say "NOTE: ~/.local/bin is not on PATH — ssh runs the probe by name, and a Match" ;
     say "      block that cannot find it silently falls back to the public address." ;;
esac

# 2. ssh config — replace our own managed block, leave everything else alone
mkdir -p "\$HOME/.ssh"; touch "\$SSH_CFG"
cp "\$SSH_CFG" "\$SSH_CFG.bak-\$STAMP"
awk -v a=\${ALIAS} '\$0=="# >>> remote-devbox "a" >>>"{skip=1} !skip{print} \$0=="# <<< remote-devbox "a" <<<"{skip=0}' \\
  "\$SSH_CFG.bak-\$STAMP" > "\$SSH_CFG"
fetch --ssh-config >> "\$SSH_CFG"
say "updated ~/.ssh/config (backup: config.bak-\$STAMP)"

# 3. the CLI binary. uname's spelling is not bun's: x86_64 is x64 and aarch64 is arm64.
PLATFORM=\$(uname -s | tr '[:upper:]' '[:lower:]')-\$(uname -m | sed -e 's/^x86_64\$/x64/' -e 's/^aarch64\$/arm64/')
if REMOTE=\$(fetch "--cli \$PLATFORM" 2>&1); then
  scp -q "\$USER_NAME@\$BOX:\$REMOTE" "\$HOME/.local/bin/devbox.incoming"
  # Verify before trusting it: a truncated 60MB binary segfaults, and that failure is
  # much harder to read than a checksum mismatch.
  WANT=\$(ssh -o BatchMode=yes "\$USER_NAME@\$BOX" \\
    "awk '/devbox-\$PLATFORM\$/ {print \\\$1}' /usr/local/share/remote-devbox/clients/SHA256SUMS")
  if command -v sha256sum >/dev/null 2>&1; then
    GOT=\$(sha256sum "\$HOME/.local/bin/devbox.incoming" | cut -d' ' -f1)
  else
    GOT=\$(shasum -a 256 "\$HOME/.local/bin/devbox.incoming" | cut -d' ' -f1)
  fi
  if [ -n "\$WANT" ] && [ "\$WANT" != "\$GOT" ]; then
    rm -f "\$HOME/.local/bin/devbox.incoming"
    say "the CLI binary arrived corrupted (checksum mismatch) — not installing it"
    exit 1
  fi
  chmod +x "\$HOME/.local/bin/devbox.incoming"
  # Backed up like everything else here. If you develop the CLI, the thing being replaced
  # is your live-source wrapper — the backup is how you put it back.
  # Spelled as an if, not as test-and-cp: under set -e a false test is a failed command,
  # so a machine that has no devbox yet would exit here instead of installing one.
  # (Backticks are avoided throughout this heredoc — it is unquoted, so they would run
  # here on the box at generation time rather than reach the client as text.)
  if [ -f "\$HOME/.local/bin/devbox" ]; then
    cp "\$HOME/.local/bin/devbox" "\$HOME/.local/bin/devbox.bak-\$STAMP"
  fi
  mv "\$HOME/.local/bin/devbox.incoming" "\$HOME/.local/bin/devbox"
  say "wrote ~/.local/bin/devbox (\$(\$HOME/.local/bin/devbox --version))"
else
  say "no CLI binary for \$PLATFORM: \$REMOTE"
  say "ssh still works; the CLI can be run from a checkout with 'bun run src/devbox.ts'."
fi

# 4. client config for the devbox CLI
#
# The CLI prefers ~/.config/remote-devbox and reads the pre-rename ~/.config/claude-devbox
# only when it is the only one present. Write whichever this client already uses, so this
# never creates a second config that silently wins over the one in use.
CFG_DIR="\$HOME/.config/remote-devbox"
if [ -f "\$HOME/.config/claude-devbox/config.json" ] && [ ! -f "\$CFG_DIR/config.json" ]; then
  CFG_DIR="\$HOME/.config/claude-devbox"
fi
CFG="\$CFG_DIR/config.json"
mkdir -p "\$CFG_DIR"

if [ -f "\$CFG" ]; then
  cp "\$CFG" "\$CFG.bak-\$STAMP"
  # Merge rather than truncate: keys the box cannot know are the client's own, and
  # dropping repoPath is what stops the CLI reading devbox.yml — which is where the sync
  # disk and app configs are declared. A backup does not help a user who never noticed.
  if command -v python3 >/dev/null 2>&1; then
    fetch --json > "\$CFG.new"
    python3 - "\$CFG.bak-\$STAMP" "\$CFG.new" "\$CFG" <<'MERGE'
import json, sys
old, new, out = (json.load(open(p)) if i < 2 else p for i, p in enumerate(sys.argv[1:4]))
# The box owns what it actually knows. It emits a placeholder for the launch command it
# cannot know, so an empty value must never overwrite a setting the client already has,
# and keys the box does not emit at all (repoPath) are left untouched.
for key, value in new.items():
    if value in ("", None) and old.get(key) not in ("", None):
        continue
    old[key] = value
json.dump(old, open(out, "w"), indent=2)
open(out, "a").write("\\n")
MERGE
    rm -f "\$CFG.new"
    say "updated \$(printf %s "\$CFG" | sed "s|\$HOME|~|") (backup: config.json.bak-\$STAMP)"
  else
    fetch --json > "\$CFG"
    say "wrote \$(printf %s "\$CFG" | sed "s|\$HOME|~|") — python3 not found, so any"
    say "     client-only keys were replaced; the previous file is config.json.bak-\$STAMP"
  fi
else
  fetch --json > "\$CFG"
  say "wrote \$(printf %s "\$CFG" | sed "s|\$HOME|~|")"
fi

# 5. prove it, rather than asserting it
echo
if ssh -o BatchMode=yes -o ConnectTimeout=10 -T "\$ALIAS" 'true' 2>/dev/null; then
  VIA=\$(ssh -o BatchMode=yes -T "\$ALIAS" 'echo \$SSH_CONNECTION | cut -d" " -f3' 2>/dev/null)
  say "\$ALIAS works (connected via \$VIA)"
else
  say "\$ALIAS did NOT connect. Check that your key is the one registered for \$USER_NAME,"
  say "and that IdentityFile in the new ~/.ssh/config block points at it."
  exit 1
fi
echo
echo "Done. Connect with:  ssh \$ALIAS"
INSTALLER
}

cmd_client_config() {
  local user="$ME" what="" plat=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ssh-config|--json|--probe|--installer) what="$1" ;;
      --cli) what="$1"; plat="${2:-}"; [ -n "$plat" ] && shift ;;
      -*) die "unknown flag '$1' (--installer|--ssh-config|--json|--probe|--cli)" ;;
      *) user="$1" ;;
    esac
    shift
  done
  [ -r "$CLIENT" ] || die "no client facts at $CLIENT — re-run the playbook"

  case "$what" in
    --ssh-config) emit_ssh_config "$user" ;;
    --json) emit_client_json "$user" ;;
    --probe) cat /usr/local/share/remote-devbox/devbox-tailnet-up ;;
    --cli) emit_cli_path "$plat" ;;
    --installer) emit_installer "$user" ;;
    "")
      local published
      published=$(cd "$CLIENT_BIN" 2>/dev/null && ls devbox-* 2>/dev/null | sed 's/^devbox-//' | tr '\n' ' ')
      cat <<EOF
Set up your own machine to reach this box as $user:

  ssh $user@$(client_field public_host) 'devbox client-config --installer' > devbox-setup.sh
  less devbox-setup.sh          # it writes three files and backs up each one
  sh devbox-setup.sh

It is printed rather than piped into a shell on purpose: you should be able to read what
is about to be written to your machine.

Individual pieces, if you would rather place them yourself:
  --probe        the tailnet probe        -> ~/.local/bin/devbox-tailnet-up
  --ssh-config   the managed ssh block    -> ~/.ssh/config
  --json         the devbox CLI config    -> ~/.config/remote-devbox/config.json
  --cli <plat>   path to the CLI binary   -> scp it to ~/.local/bin/devbox
                 platforms published here: ${published:-none}
EOF
      ;;
  esac
}

case "${1:-}" in
  engine) shift; cmd_engine "$@" ;;
  container) shift; cmd_container "$@" ;;
  compose) shift; cmd_compose "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  client-config) shift; cmd_client_config "$@" ;;
  ""|-h|--help|help)
    sed -n '5,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command '$1' (engine|container|compose|doctor|client-config)" ;;
esac
