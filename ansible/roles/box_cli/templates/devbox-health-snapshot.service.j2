# Managed by Ansible (remote-devbox) — do not edit by hand.
[Unit]
Description=Collect sanitized remote-devbox health evidence
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/remote-devbox-doctor snapshot
RuntimeDirectory=remote-devbox
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadWritePaths=/run/remote-devbox
TimeoutStartSec=30s
