# Managed by Ansible (remote-devbox) — do not edit by hand.
#
# hindsight-embed owns a background daemon, so systemd runs a foreground monitor as
# the main process. If the daemon or its socket disappears the monitor exits non-zero;
# Restart=on-failure then starts the daemon again with bounded delay.
#
# A user service, not a system one: the daemon runs as the developer, inside their
# resource slice. linger (developers role) keeps it up after logout.
[Unit]
Description=Hindsight memory daemon ({{ item.name }}) for {{ item.user }}
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
ExecStartPre=/bin/bash -lc 'uvx hindsight-embed -p {{ item.name }} daemon start'
ExecStart=/bin/bash -lc 'while uvx hindsight-embed -p {{ item.name }} daemon status >/dev/null 2>&1 && ss -Hltn | grep -q "127.0.0.1:{{ item.port }} "; do sleep 10; done; exit 1'
ExecStop=/bin/bash -lc 'uvx hindsight-embed -p {{ item.name }} daemon stop'
TimeoutStartSec=600
Restart=on-failure
RestartSec=5s
# Background service, not interactive work: yield under contention.
Nice=5
{% set L = item.resources | default({}) %}
{% if 'memory_high' in L %}MemoryHigh={{ L.memory_high }}
{% endif %}
{%- if 'memory_max' in L %}MemoryMax={{ L.memory_max }}
{% endif %}
{%- if 'memory_swap_max' in L %}MemorySwapMax={{ L.memory_swap_max }}
{% endif %}
{#- The daemon and its embedded Postgres are backgrounded by hindsight-embed, so
    systemd's main process is only a monitor and the stop sequence is what has to
    clear the cgroup. SIGTERM cannot: to a postmaster it means "smart shutdown",
    i.e. wait for clients to disconnect, indefinitely. That is why the postgres
    backends outlived a restart and every start logged them as left-over processes
    it then ran beside. SIGINT is postgres' fast shutdown; SIGKILL bounds the wait. #}
KillMode=control-group
KillSignal=SIGINT
FinalKillSignal=SIGKILL
TimeoutStopSec=30
# The ceiling above is this unit's containment boundary, so parent-slice oomd must stop
# selecting it as the cheap victim while the agent hosts hold the memory.
ManagedOOMPreference=avoid

[Install]
WantedBy=default.target
