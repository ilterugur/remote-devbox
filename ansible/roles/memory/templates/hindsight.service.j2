# Managed by Ansible (remote-devbox) — do not edit by hand.
#
# hindsight-embed owns a background daemon, so systemd runs a foreground monitor as
# the main process. If the daemon or its socket disappears the monitor exits non-zero;
# Restart=on-failure then starts the daemon again with bounded delay.
#
# A user service, not a system one: the daemon runs as the developer, inside their
# resource slice. linger (developers role) keeps it up after logout.
[Unit]
Description=Hindsight memory daemon ({{ item.name }}) for {{ item.user }}
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
ExecStartPre=/bin/bash -lc 'uvx hindsight-embed -p {{ item.name }} daemon start'
ExecStart=/bin/bash -lc 'while uvx hindsight-embed -p {{ item.name }} daemon status >/dev/null 2>&1 && ss -Hltn | grep -q "127.0.0.1:{{ item.port }} "; do sleep 10; done; exit 1'
ExecStop=/bin/bash -lc 'uvx hindsight-embed -p {{ item.name }} daemon stop'
TimeoutStartSec=600
Restart=on-failure
RestartSec=5s
# Background service, not interactive work: yield under contention.
Nice=5

[Install]
WantedBy=default.target
