# Managed by Ansible (remote-devbox) — do not edit by hand. Mode 0600: holds an API key.
#
# One file per memory instance. The daemon inherits this environment, so changing a
# provider here needs a daemon restart (the handler does that).
HINDSIGHT_USER_ID={{ item.user }}
HINDSIGHT_API_PORT={{ item.port }}
# Loopback only. Another developer on this box could still reach a wide-bound port, and
# the daemon has no authentication of its own.
HINDSIGHT_API_HOST=127.0.0.1

HINDSIGHT_API_LLM_PROVIDER={{ item.llm_provider }}
{% if item.llm_model %}
HINDSIGHT_API_LLM_MODEL={{ item.llm_model }}
{% endif %}
{% if item.llm_base_url %}
HINDSIGHT_API_LLM_BASE_URL={{ item.llm_base_url }}
{% endif %}
{% if item.api_key_env and devbox_secrets.get(item.api_key_env) %}
HINDSIGHT_API_LLM_API_KEY={{ devbox_secrets[item.api_key_env] }}
{% endif %}
