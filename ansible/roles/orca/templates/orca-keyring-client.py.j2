#!/usr/bin/python3 -I
"""User-side fail-closed checks; this program never receives the unlock secret."""
import os
from pathlib import Path
import stat
import subprocess
import sys

import dbus

NAME = "org.freedesktop.secrets"
ROOT = "/org/freedesktop/secrets"
PROPERTIES = "org.freedesktop.DBus.Properties"
SERVICE = "org.freedesktop.Secret.Service"
COLLECTION = "org.freedesktop.Secret.Collection"


def require_private(path, directory=False):
    info = path.lstat()
    expected = stat.S_ISDIR if directory else stat.S_ISREG
    if not expected(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise RuntimeError(f"expected a private, user-owned, non-symlink path: {path}")


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("absent", "check", "ready") or os.getuid() == 0:
        raise RuntimeError("expected a user-side keyring check")
    mode = sys.argv[1]
    bus = dbus.SessionBus()
    daemon = dbus.Interface(bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus", introspect=False), "org.freedesktop.DBus")
    # Query the bus itself, never activate an unknown secrets provider.
    if not daemon.NameHasOwner(NAME, timeout=10):
        if mode == "ready":
            raise RuntimeError("managed SecretService is not running")
        return
    if mode == "absent":
        raise RuntimeError("an existing SecretService owns the user bus; refusing replacement")
    owner = str(daemon.GetNameOwner(NAME, timeout=10))
    pid = int(daemon.GetConnectionUnixProcessID(owner, timeout=10))
    if int(daemon.GetConnectionUnixUser(owner, timeout=10)) != os.getuid():
        raise RuntimeError("SecretService belongs to another user")
    group = subprocess.check_output(
        ["/usr/bin/systemctl", "--user", "show", "orca-keyring.service", "--property=ControlGroup", "--value"],
        text=True, timeout=10,
    ).strip()
    expected = f"/user-{os.getuid()}.slice/user@{os.getuid()}.service/"
    if not group.endswith("/orca-keyring.service") or expected not in group:
        raise RuntimeError("managed keyring service has no expected cgroup")
    groups = [line.split(":", 2)[2] for line in Path(f"/proc/{pid}/cgroup").read_text().splitlines()]
    if group not in groups:
        raise RuntimeError("foreign SecretService owner; refusing to adopt or unlock it")
    if mode == "check":
        return
    # Bind to the unique owner so a name swap cannot redirect collection queries.
    service = dbus.Interface(bus.get_object(owner, ROOT, introspect=False), SERVICE)
    login = str(service.ReadAlias("login", timeout=10))
    default = str(service.ReadAlias("default", timeout=10))
    if login == "/" or default != login:
        raise RuntimeError("managed login collection is missing or is not the default")
    properties = dbus.Interface(bus.get_object(owner, login, introspect=False), PROPERTIES)
    if bool(properties.Get(COLLECTION, "Locked", timeout=10)):
        raise RuntimeError("login/default collection is locked; restart the managed keyring service to unlock")
    data = Path(os.environ["XDG_DATA_HOME"])
    require_private(data, directory=True)
    require_private(data / "keyrings", directory=True)
    keyring = data / "keyrings" / "login.keyring"
    require_private(keyring)
    fd = os.open(keyring, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as source:
        # GNOME's binary encrypted format, not its plaintext .keyring format.
        # gkm-secret-binary.c: 16-byte magic then version/cipher/hash IDs (all zero).
        if source.read(20) != b"GnomeKeyring\n\r\x00\n" + bytes(4):
            raise RuntimeError("login keyring is not the supported encrypted GNOME file format")
    if str(daemon.GetNameOwner(NAME, timeout=10)) != owner:
        raise RuntimeError("SecretService owner changed during readiness check")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, KeyError, ValueError, dbus.DBusException, subprocess.SubprocessError) as error:
        print(f"Orca keyring refused: {error}", file=sys.stderr)
        sys.exit(1)
