# Managed by Ansible (remote-devbox Orca).
{% set L = row.resources %}
[Unit]
Description=Orca runtime ({{ row.user }}, {{ row.version }})
After=network-online.target
Wants=network-online.target
{% if row.relay %}
Requires=orca-keyring.service
After=orca-keyring.service
{% endif %}
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Slice={{ 'orca.slice' if row.relay else 'app.slice' }}
WorkingDirectory={{ orca_home }}
Environment=HOME={{ orca_home }}
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=ORCA_TELEMETRY_DISABLED=1
{% if row.relay %}
Environment=XDG_RUNTIME_DIR=/run/user/{{ orca_uid }}
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ orca_uid }}/bus
{% endif %}
Environment=TMPDIR=/var/tmp/devbox-scratch/{{ row.user }}
Environment=PATH={% if row.heavy_job_gate_enabled %}/usr/local/lib/agent-devbox/heavy-command-gate:{% endif %}{{ orca_home }}/.local/share/mise/shims:{{ orca_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
{% if row.heavy_job_gate_enabled %}
Environment=DEVBOX_HEAVY_JOB_CATEGORIES={{ row.heavy_job_gate_categories | join(',') }}
Environment=DEVBOX_HEAVY_JOB_WAIT_TIMEOUT_SEC={{ row.heavy_job_gate_wait_timeout_sec }}
Environment=DEVBOX_HEAVY_JOB_WARN_AFTER_SEC={{ row.heavy_job_gate_warn_after_sec }}
Environment=DEVBOX_HEAVY_JOB_MEMORY_MAX={{ row.heavy_job_gate_memory_max }}
{% for category, limit in (row.heavy_job_gate_memory_max_by_category | default({})).items() %}Environment=DEVBOX_HEAVY_JOB_MEMORY_MAX_{{ category | upper }}={{ limit }}
{% endfor %}
{% endif %}
# systemd creates this invocation's cgroup before ExecStartPre. nft resolves that exact
# cgroup, including descendants, and a missing nft/kernel capability prevents launch.
ExecStartPre=/usr/bin/sudo -n /usr/local/sbin/devbox-orca-firewall {{ row.user }}
{% if row.relay %}
ExecStartPre=/usr/bin/sudo -n /usr/local/sbin/devbox-orca-keyring {{ row.user }}
{% endif %}
ExecStartPre=/usr/local/lib/agent-devbox/orca-agent-settings {{ orca_home }}/.config/orca/orca-data.json {{ orca_home }}/.config/orca-devbox-agent-settings.json
# A private authenticated X display per invocation avoids cross-developer :99 collisions.
{% if row.relay %}
ExecStart=/usr/bin/xvfb-run --auto-servernum "--server-args=-screen 0 1280x1024x24 -nolisten tcp" /opt/orca/{{ row.version }}/squashfs-root/AppRun --password-store=gnome-libsecret
{% else %}
ExecStart=/usr/bin/xvfb-run --auto-servernum "--server-args=-screen 0 1280x1024x24 -nolisten tcp" /opt/orca/{{ row.version }}/squashfs-root/AppRun serve --port {{ row.port }} --pairing-address {{ row.pairing_address | to_json(ensure_ascii=False) | replace('%', '%%') | replace('$', '$$') }} --json
{% endif %}
ExecStartPost=/usr/local/lib/agent-devbox/orca-ready {{ row.port }} {{ 'desktop' if row.relay else 'serve' }}
TimeoutStartSec=150
TimeoutStopSec=30
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5
# xvfb-run owns its X server; an intentional stop terminates the complete invocation.
KillMode=control-group
StandardOutput=journal
StandardError=journal
{% if 'memory_high' in L %}MemoryHigh={{ L.memory_high }}
{% endif %}
MemoryMax={{ L.memory_max }}
{% if 'memory_swap_max' in L %}MemorySwapMax={{ L.memory_swap_max }}
{% endif %}
{% if 'cpu_weight' in L %}CPUWeight={{ L.cpu_weight }}
{% endif %}
{% if 'cpu_quota' in L %}CPUQuota={{ L.cpu_quota }}
{% endif %}
{% if 'io_weight' in L %}IOWeight={{ L.io_weight }}
{% endif %}
{% if 'nice' in L %}Nice={{ L.nice }}
{% endif %}
{% if 'oom_score_adjust' in L %}OOMScoreAdjust={{ L.oom_score_adjust }}
{% endif %}
OOMPolicy={{ L.oom_policy | default('continue') }}
ManagedOOMPreference=omit

[Install]
WantedBy=default.target
