# Managed by Ansible (remote-devbox) — do not edit by hand.
#
# Codex spawns every command as `bash -lc`. The login shell sources this directory, and
# mise's activation prepends its installs/*/bin ahead of everything the daemon unit
# passed down — so on 2026-08-20 bun, node and npm all resolved to the real toolchain
# and no build a Codex session ran was ever gated. Measured with one identical PATH:
#
#   non-login shell:  bun -> /usr/local/lib/agent-devbox/heavy-command-gate/bun
#   login shell:      bun -> ~/.local/share/mise/installs/bun/latest/bin/bun
#
# This file sorts after mise's snippet on purpose: it re-prepends the gate once
# activation has had its say. Note the scope of the fix — mise also installs a
# prompt/chpwd hook that can retake the front of PATH in a long-lived interactive
# shell. That does not affect the failure this closes: each agent command is a fresh
# non-interactive `bash -lc`, where activation runs once and this runs after it.
#
# It only ever hands the gate to a developer the roster names. A developer whose gate is
# off is absent from that file and their PATH is left byte-identical.
#
# Two branches, because there are two ways to lose the gate. The first is ORDER: the
# directory is on PATH but behind mise's activation, measured 2026-08-20 above. The
# second is ABSENCE, measured 2026-09-05 and the more expensive of the two: in a login
# shell whose inherited PATH never had the directory at all — `sudo -u <dev> bash -lc`,
# cron, a release wrapper started from a stripped environment — the reorder branch had
# nothing to reorder, so `command -v bun` still resolved to
# ~/.local/share/mise/installs/bun/1.4.0/bin/bun and the build it launched ran ungated.
# That one grew to 13.8 GB inside the session fleet's cgroup and stalled every session on
# the box for hours.
__devbox_gate_dir=${DEVBOX_HEAVY_GATE_DIR:-/usr/local/lib/agent-devbox/heavy-command-gate}
__devbox_gate_roster=${DEVBOX_HEAVY_GATE_ROSTER:-/etc/agent-devbox/heavy-gate-users}

# One `read` loop over a small file, no subshell and no external command: this runs on
# every `bash -lc`, so its cost is paid by every command an agent issues. A missing
# roster leaves PATH untouched rather than failing the shell.
__devbox_gate_listed=
if [ -r "$__devbox_gate_roster" ]; then
  while IFS= read -r __devbox_roster_user || [ -n "$__devbox_roster_user" ]; do
    if [ "$__devbox_roster_user" = "${USER:-$(id -un)}" ]; then
      __devbox_gate_listed=yes
      break
    fi
  done < "$__devbox_gate_roster"
fi

case ":${PATH}:" in
  *":${__devbox_gate_dir}:"*)
    # Drop the existing entry before re-prepending, so repeated sourcing cannot grow PATH.
    # The trailing newline matters: `read` discards a final unterminated line, so
    # printing without one silently drops the last PATH entry on every source.
    __devbox_new_path=$(
      printf '%s\n' "$PATH" | tr ':' '\n' |
        while IFS= read -r __devbox_entry; do
          [ -n "$__devbox_entry" ] || continue
          [ "$__devbox_entry" = "$__devbox_gate_dir" ] && continue
          printf '%s\n' "$__devbox_entry"
        done | paste -sd: -
    )
    PATH="${__devbox_gate_dir}:${__devbox_new_path}"
    export PATH
    unset __devbox_new_path __devbox_entry
    ;;
  *)
    # Absent entirely: only a rostered developer gets it, and only when the shims are
    # actually installed — handing out a directory that does not exist would put a dead
    # entry at the front of PATH for every command on the box.
    if [ -n "$__devbox_gate_listed" ] && [ -d "$__devbox_gate_dir" ]; then
      PATH="${__devbox_gate_dir}:${PATH}"
      export PATH
    fi
    ;;
esac
unset __devbox_gate_dir __devbox_gate_roster __devbox_gate_listed __devbox_roster_user
