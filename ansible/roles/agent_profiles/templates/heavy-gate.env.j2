# Managed by Ansible (remote-devbox) — do not edit by hand.
#
# The shared heavy build/typecheck/generate/test slot for {{ item.user }}. Every agent
# this developer owns queues on one kernel flock, so unrelated light commands stay
# concurrent while the jobs that can eat the whole memory budget run one at a time.
#
# Sourced rather than templated into each entry point, because there is more than one:
# the interactive launcher execs the agent binary directly, while an always-on Remote
# Control session comes up through agent-rc-run instead. Both source this file, so the
# gate cannot be wired into one path and silently missing from the other.
#
# Source it AFTER mise activation. The gate only bites while its shims sit ahead of
# mise's on PATH; behind them, every command resolves to the real toolchain and the
# flock is never taken.
export PATH="/usr/local/lib/agent-devbox/heavy-command-gate:$PATH"
export DEVBOX_HEAVY_JOB_CATEGORIES="{{ item.heavy_job_gate_categories | default(['build', 'typecheck', 'generate', 'test']) | join(',') }}"
export DEVBOX_HEAVY_JOB_WAIT_TIMEOUT_SEC="{{ item.heavy_job_gate_wait_timeout_sec | default(1800) }}"
export DEVBOX_HEAVY_JOB_WARN_AFTER_SEC="{{ item.heavy_job_gate_warn_after_sec | default(5) }}"
