#!/usr/bin/env bash
# Managed by Ansible (remote-devbox) — do not edit by hand.
set -euo pipefail

ENGINE=/usr/local/share/remote-devbox/devbox-codex-account.sh

if [[ $EUID -ne 0 ]]; then
  echo "remote-devbox-codex-account: run me with sudo (it switches to the developer)." >&2
  exit 1
fi

PROFILES=(
{% for p in _devbox_agent_profiles | selectattr('provider', 'equalto', 'codex') %}
  "{{ p.user }}:{{ p.name }}"
{% endfor %}
)

if [[ -z "${PROFILES[*]:-}" ]]; then
  echo "remote-devbox-codex-account: no Codex agent profile is declared on this box." >&2
  exit 1
fi

usage() {
  cat >&2 <<'USAGE'
usage: sudo remote-devbox-codex-account <developer> <profile> <verb> [args...]

verbs:
  ls [--json]              the labels this profile holds, and which one is active
  status [--json]          active label plus what the config tree actually contains
  add <label>              adopt the account logged in right now under this label
  use <label> [--force]    the swap (refused while codex runs, unless --force)
  rm <label>
  gc [--keep N]            prune parked backups (newest 3 kept by default)
USAGE
  echo "known developer/profile pairs:" >&2
  printf '  %s\n' "${PROFILES[@]}" >&2
  exit 1
}

[[ $# -ge 3 ]] || usage

dev="$1"
profile="$2"
verb="$3"
shift 3

matched=0
for entry in "${PROFILES[@]}"; do
  [[ "$entry" == "$dev:$profile" ]] || continue
  matched=1
  break
done

if [[ $matched -eq 0 ]]; then
  echo "remote-devbox-codex-account: no Codex agent profile '$dev/$profile'." >&2
  printf '  known: %s\n' "${PROFILES[@]}" >&2
  exit 1
fi

set +e
sudo -u "$dev" env   "HOME=/home/$dev"   "CODEX_HOME=/home/$dev/.agent-profiles/$profile"   "$ENGINE" "$verb" "$@"
rc=$?
set -e
exit "$rc"
