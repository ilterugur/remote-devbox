#!/usr/bin/env bash
# Managed by Ansible (remote-devbox) — do not edit by hand.
#
# Launcher for agent profile "{{ item.name }}" ({{ item.provider }}) of {{ item.user }}.
# Pointing {{ devbox_agent_adapters[item.provider].config_env }} at this profile's own
# tree is what keeps several logins of the same provider apart: credentials, history and
# settings never touch another profile's.
set -euo pipefail

export {{ devbox_agent_adapters[item.provider].config_env }}="{{ '/home/' ~ item.user ~ '/.agent-profiles/' ~ item.name }}"
export DEVBOX_AGENT_PROFILE="{{ item.name }}"
export DEVBOX_AGENT_PROVIDER="{{ item.provider }}"

# Written by the memory role when this profile has a memory space. Sourced rather
# than templated in, so exactly one role owns this file.
MEMORY_ENV="{{ '/home/' ~ item.user ~ '/.agent-profiles/' ~ item.name }}/memory.env"
[ -f "$MEMORY_ENV" ] && . "$MEMORY_ENV"

# mise shims so the agent's own shell tools resolve the pinned toolchain.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash --shims 2>/dev/null || true)"
fi

# All agents owned by this developer share one heavy build/typecheck/generate/test
# slot. Keep this after mise activation so the gate stays ahead of mise's shims.
{% if item.heavy_job_gate_enabled | default(true) %}
export PATH="/usr/local/lib/agent-devbox/heavy-command-gate:$PATH"
export DEVBOX_HEAVY_JOB_CATEGORIES="{{ item.heavy_job_gate_categories | default(['build', 'typecheck', 'generate', 'test']) | join(',') }}"
export DEVBOX_HEAVY_JOB_WAIT_TIMEOUT_SEC="{{ item.heavy_job_gate_wait_timeout_sec | default(1800) }}"
export DEVBOX_HEAVY_JOB_WARN_AFTER_SEC="{{ item.heavy_job_gate_warn_after_sec | default(5) }}"
{% endif %}

exec "{{ '/home/' ~ item.user ~ '/' ~ devbox_agent_adapters[item.provider].bin_path }}" "$@"
