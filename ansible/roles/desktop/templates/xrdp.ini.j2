; Managed by Ansible (remote-devbox) — do not edit by hand.
;
; The bind address lives inside `port=` (there is no `address=` key) and needs the
; tcp:// prefix — a bare "127.0.0.1:3389" is parsed as plain 0.0.0.0 and silently binds
; every interface, which is exactly the kind of decorative hardening worth not shipping.
; Verified on xrdp 0.10: with the prefix the socket really is address-scoped, so a path
; missing from the access list has no listener at all, firewall or no firewall.
[Globals]
ini_version=1
fork=true
{% set _p = devbox_desktop_port | default(3389) %}
{% set _binds = [] %}
{% for a in _devbox_desktop_access %}
{%   if a == 'tunnel' %}{{ _binds.append('tcp://127.0.0.1:' ~ _p) or '' }}
{%   elif a == 'tailnet' %}{{ _binds.append('tcp://' ~ ansible_facts.tailscale0.ipv4.address ~ ':' ~ _p) or '' }}
{%   elif a == 'unsafe-public' %}{{ _binds.append('tcp://0.0.0.0:' ~ _p) or '' }}
{%   endif %}
{% endfor %}
port={{ _binds | join(' ') }}
use_vsock=false
tcp_nodelay=true
tcp_keepalive=true
security_layer=negotiate
crypt_level=high
; Certificate pinning is not possible here, but requiring TLS keeps credentials off the
; wire in cleartext.
ssl_protocols=TLSv1.2, TLSv1.3
max_bpp=32
new_cursors=true
allow_channels=true
; Clipboard yes, drive redirection no: a redirected client drive would let anything
; running in the session read the connecting machine's filesystem.
allow_multimon=true

[Logging]
LogFile=/var/log/xrdp.log
LogLevel=INFO

[Xorg]
name=Xorg
lib=libxup.so
username=ask
password=ask
ip=127.0.0.1
port=-1
code=20
