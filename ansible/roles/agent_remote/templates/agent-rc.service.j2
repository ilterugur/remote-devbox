{# Managed by Ansible (remote-devbox). One unit per (developer, project).
   Every value comes from devbox_rc_units / devbox_remote_control — no default() here:
   a missing key is a generator bug, not a policy decision to make in a template. #}
{% set ID = row.agent ~ '-' ~ row.user ~ '-' ~ row.project %}
{% set L = row.resources %}
{% set RC = devbox_remote_control %}
[Unit]
Description={{ row.agent }} remote-control ({{ ID }})
After=network-online.target
Wants=network-online.target
{% if RC.autorestart.enabled %}
{# Cap restart churn: at most burst restarts per interval, else give up. #}
StartLimitIntervalSec={{ RC.autorestart.interval }}
StartLimitBurst={{ RC.autorestart.burst }}
{% endif %}

[Service]
{% if RC.autorestart.enabled %}
{# Self-heal: a oneshot+RemainAfterExit unit goes to "failed (oom-kill)" and STAYS
   down when the cgroup is OOM-killed. Instead we run a blocking monitor as the main
   process: ExecStartPre spawns the detached tmux server, ExecStart blocks while that
   session lives and exits non-zero the moment it dies (OOM/kill/crash), so
   Restart=on-failure brings the whole unit back in RestartSec. #}
Type=simple
ExecStartPre=/usr/local/bin/agent-rc-wrapper {{ ID }}
ExecStart=/usr/local/bin/agent-rc-monitor {{ ID }}
Restart=on-failure
RestartSec={{ RC.autorestart.restart_sec }}
{% else %}
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/agent-rc-wrapper {{ ID }}
{% endif %}
User={{ row.user }}
{# The developer's whole footprint — shells, editor server, builds and these RC
   sessions — shares one slice, so the ceiling in devbox.yml means what it says.
   Without this the unit lands in system.slice, where no developer limit reaches it. #}
Slice=user-{{ ansible_facts.getent_passwd[row.user][1] }}.slice
Environment=HOME=/home/{{ row.user }}
Environment=PATH=/home/{{ row.user }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
{# /tmp is a tmpfs at half of RAM: anything a session writes there is resident memory
   that can only be swapped, never dropped. Container tooling routinely leaves multiple
   gigabytes of scratch behind, which is a memory outage rather than a disk one. Point
   sessions at disk-backed scratch instead; the oomd role declares the directory. #}
Environment=TMPDIR=/var/tmp/devbox-scratch/{{ row.user }}
{# The profile IS the config dir. `remote-devbox-login` drives the profile launcher,
   which exports this variable before it execs the agent — so a unit without it reads
   the developer's DEFAULT tree while /login wrote the profile's, and the always-on
   server then serves a different account than the one you logged in as. Two credential
   trees with no bridge. agent-rc-run honours CLAUDE_CONFIG_DIR already; the row names
   the variable because it differs per provider (CODEX_HOME, PI_CODING_AGENT_DIR). #}
Environment={{ row.config_env }}={{ row.config_dir }}
Environment=CLAUDE_RC_PROJECT_DIR={{ row.project_dir }}
{# Quote values: names like "Example Monorepo" contain spaces — unquoted, systemd
   parses everything after the space as a second, invalid env assignment. #}
Environment="CLAUDE_RC_NAME={{ row.name }}"
Environment=CLAUDE_RC_SPAWN={{ row.spawn }}
Environment=CLAUDE_RC_CAPACITY={{ row.capacity }}
Environment=CLAUDE_RC_AGENT={{ row.agent }}
{# The session execs the agent binary directly rather than going through the profile
   launcher, so agent-rc-run sources this profile's memory.env itself. Without the
   profile name it cannot find the file, and memory is silently off in RC sessions. #}
Environment=CLAUDE_RC_AGENT_PROFILE={{ row.agent_profile }}
{% for k, v in row.build_env.items() %}
Environment="{{ k }}={{ v }}"
{% endfor %}
ExecStop=/usr/bin/tmux -L agent-rc-{{ ID }} kill-server
{% if RC.resume.on_boot %}
{# Trigger the boot/recovery orchestrator on EVERY start — including Restart=
   auto-restarts after an OOM, which do NOT re-pull Wants= dependencies (so a plain
   Wants= would only fire on a clean `systemctl start`, not on self-heal). Prefixes:
   '-' makes it best-effort (a failed trigger must NOT fail/restart the RC unit),
   '+' runs it as root (the service runs as the profile user, which can't call
   systemctl). --no-block returns immediately so it never delays the unit becoming
   active, and the companion is idempotent (it skips sessions already running). #}
ExecStartPost=-+/usr/bin/systemctl start --no-block agent-rc-resume-{{ ID }}.service
{% endif %}
{# ── Resource control (systemd cgroup) ──────────────────────────────────────────
   The slice above is the shared ceiling. These are the per-unit knobs: the weights
   and the nice value always apply, while a memory ceiling appears only when this
   project asked for one. A ceiling inherited from a box that has since grown is the
   failure that omission exists to prevent. #}
{% if 'memory_high' in L %}MemoryHigh={{ L.memory_high }}
{% endif %}
{%- if 'memory_max' in L %}MemoryMax={{ L.memory_max }}
{% endif %}
{%- if 'memory_swap_max' in L %}MemorySwapMax={{ L.memory_swap_max }}
{% endif %}
{%- if 'cpu_weight' in L %}CPUWeight={{ L.cpu_weight }}
{% endif %}
{%- if 'cpu_quota' in L %}CPUQuota={{ L.cpu_quota }}
{% endif %}
{%- if 'io_weight' in L %}IOWeight={{ L.io_weight }}
{% endif %}
{%- if 'nice' in L %}Nice={{ L.nice }}
{% endif %}
{%- if 'oom_score_adjust' in L %}OOMScoreAdjust={{ L.oom_score_adjust }}
{% endif %}
{%- if 'oom_policy' in L %}OOMPolicy={{ L.oom_policy }}
{% endif %}
{# Already bounded by MemoryMax above, and OOMPolicy=continue makes that bound kill the
   build rather than the session. oomd must not pick these units when a neighbour in the
   same slice is the one overrunning. #}
ManagedOOMPreference=avoid
[Install]
WantedBy=multi-user.target
