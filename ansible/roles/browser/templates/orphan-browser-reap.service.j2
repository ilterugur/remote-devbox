{# Managed by Ansible (remote-devbox) — do not edit by hand. #}
{% set R = devbox_browser.reap %}
[Unit]
Description=Reap browser instances stranded by dead agent sessions
Documentation=man:orphan-browser-reap(8)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/orphan-browser-reap --grace-sec {{ R.grace_sec }} --state /run/orphan-browser-reap/seen.json --purge-profiles-under /var/tmp/devbox-scratch
{# The reaper only kills a browser it has ALREADY seen orphaned on an earlier pass,
   so the sighting record has to outlive the oneshot. Without Preserve=yes systemd
   removes RuntimeDirectory= the moment the unit exits, every pass starts from an
   empty state, nothing ever reaches its grace, and the timer becomes a no-op that
   still looks healthy. #}
RuntimeDirectory=orphan-browser-reap
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
{# Runs as root: leaked Chromes belong to whichever developer's session spawned them,
   so it reads other users' /proc entries and signals their processes. Everything
   below narrows that down to the two things it actually needs — read /proc, write
   its own state file. #}
ProtectSystem=strict
ReadWritePaths=/run/orphan-browser-reap
{# A reaped browser's profile is deleted, so the scratch root has to be writable —
   and it has to be the REAL one. PrivateTmp gives the unit a private /var/tmp as
   well as /tmp, which would turn every removal into a no-op inside a namespace
   nobody else can see, so the host directory is bound back in on top of it. The
   bind is the narrowest grant that works: /tmp stays private. #}
BindPaths=/var/tmp/devbox-scratch
ReadWritePaths=/var/tmp/devbox-scratch
{# The harness's own browser profiles live under /home and match the same throwaway
   patterns. Only the purge root above keeps the sweep out of them; this keeps it
   out even if that rule ever regressed. Paths under /home are otherwise only ever
   matched as STRINGS out of /proc/<pid>/cmdline, never opened. #}
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
{# Four capabilities, each earned:
   CAP_KILL          — signalling another developer's browser, the whole job.
   CAP_DAC_READ_SEARCH — reading another uid's /proc/<pid>/{cmdline,cgroup} and the
                       network tables.
   CAP_SYS_PTRACE    — load-bearing and unobviously so: readlinking a foreign
                       process's /proc/<pid>/fd is ptrace-mode gated, and that fd
                       table is the only proof of who is attached to a browser's CDP
                       port. Dropped once during development, and the sweep reported
                       `listen=-` for a browser that was in fact listening.
   CAP_DAC_OVERRIDE  — each developer's scratch directory is 0700 and owned by them,
                       so even root cannot unlink a dead profile inside it without
                       this. It is bounded by the sandbox rather than by trust: with
                       ProtectSystem=strict and ProtectHome=yes above, the only
                       writable path in the whole namespace is the scratch root.
   Nothing here reads a foreign address space. #}
CapabilityBoundingSet=CAP_KILL CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_DAC_OVERRIDE
{# hide_pids mounts /proc with hidepid, and ProtectProc= would narrow the view
   further. The reaper must see every developer's browser processes, so it stays at
   the permissive setting deliberately rather than by omission. #}
ProtectProc=default
UMask=0077
TimeoutStartSec=120s
{# A janitor must never become the outage. If it wedges, it dies and tries again
   on the next tick rather than holding a slot open. #}
Nice=10
IOSchedulingClass=idle
