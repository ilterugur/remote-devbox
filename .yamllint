---
# Matches the repo's existing Ansible style: inline flow mappings for one-line role
# entries (`{ role: base, tags: [base] }`) stay readable with padded braces.
extends: default

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
